# Server-side only: used by /api/explorer and /api/analyze (Etherscan V2, all chains).
# Get a free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Optional: WalletConnect (Reown) project ID for RainbowKit. Browser wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
